NODE_ENV=development
PORT=3300
ADMIN_FRONTEND_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pepsa_admin?schema=public
# Optional: override Prisma pool size (default 5). Keep low on shared Aiven plans.
# PRISMA_CONNECTION_LIMIT=5
SESSION_COOKIE_NAME=pepsa_admin_session
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-64-hex-characters
ACTOR_SIGNING_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-at-least-24-random-characters

# Single-server deploy: loop back to this API (no separate delivery service).
RECOVERY_DELIVERY_URL=http://127.0.0.1:3300/internal/admin-recovery
RECOVERY_DELIVERY_TOKEN=replace-with-at-least-24-random-characters
SECURITY_MONITORING_URL=http://127.0.0.1:3300/internal/security-events
SECURITY_MONITORING_TOKEN=replace-with-at-least-24-random-characters

# Required for password reset / invite emails (same SMTP as BAS is fine).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pepsa Admin <no-reply@pepsa.co>"

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
# Optional second bootstrap admin (omit after first successful seed):
# BOOTSTRAP_ADMIN2_EMAIL=second-admin@example.com
# BOOTSTRAP_ADMIN2_PASSWORD=replace-with-another-strong-password
# BOOTSTRAP_ADMIN2_NAME=Second Administrator
BUSINESS_SERVICE_BASE_URL=http://localhost:3200
BUSINESS_SERVICE_AUDIENCE=pepsa-business-as-a-service
PLATFORM_REQUEST_TIMEOUT_MS=5000
PLATFORM_RETRY_ATTEMPTS=2
PLATFORM_CIRCUIT_FAILURE_THRESHOLD=5
PLATFORM_CIRCUIT_OPEN_MS=30000
