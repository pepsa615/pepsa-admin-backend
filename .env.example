NODE_ENV=development
PORT=3300
ADMIN_FRONTEND_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pepsa_admin?schema=public
SESSION_COOKIE_NAME=pepsa_admin_session
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-64-hex-characters
ACTOR_SIGNING_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-at-least-24-random-characters
RECOVERY_DELIVERY_URL=http://localhost:3400/internal/admin-recovery
RECOVERY_DELIVERY_TOKEN=replace-with-at-least-24-random-characters
SECURITY_MONITORING_URL=http://localhost:3500/internal/security-events
SECURITY_MONITORING_TOKEN=replace-with-at-least-24-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
BUSINESS_SERVICE_BASE_URL=http://localhost:3200
BUSINESS_SERVICE_AUDIENCE=pepsa-business-as-a-service
PLATFORM_REQUEST_TIMEOUT_MS=5000
PLATFORM_RETRY_ATTEMPTS=2
PLATFORM_CIRCUIT_FAILURE_THRESHOLD=5
PLATFORM_CIRCUIT_OPEN_MS=30000
